<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FlatWire</PackageId>
    <Version>0.6.0</Version>
    <Authors>The flatwire authors</Authors>
    <Description>Streaming JSON, XML and MessagePack serialization that keeps memory flat and time linear - stream large collections element-by-element.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/flatwire-io/flatwire</PackageProjectUrl>
    <RepositoryUrl>https://github.com/flatwire-io/flatwire</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.4.0: streaming MessagePack binary format (FlatMsgPack) alongside JSON and XML; wire-compatible with standard MessagePack. Full changelog: https://github.com/flatwire-io/flatwire/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>json;serialization;streaming;memory;performance</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>


